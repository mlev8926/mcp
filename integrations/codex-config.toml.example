# Merge into ~/.codex/config.toml.
# The governance repository is this NEXUS MCP checkout.
# Do not set NEXUS_WORKSPACE_ROOT until the Nexus SaaS application workspace exists.
[mcp_servers.nexus]
command = "uv"
args = ["run", "--project", "/ABSOLUTE/PATH/TO/mcp", "python", "-m", "nexus_mcp.server"]
cwd = "/ABSOLUTE/PATH/TO/mcp"
startup_timeout_sec = 20
tool_timeout_sec = 60

[mcp_servers.nexus.env]
NEXUS_GOVERNANCE_ROOT = "/ABSOLUTE/PATH/TO/mcp"
